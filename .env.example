# Copy to .env and fill in. Never commit .env.

# ---- Runtime -------------------------------------------------------------
FINFLOW_ENV=local              # local | ci | prod
FINFLOW_LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR
FINFLOW_LOG_JSON=false         # force JSON logs (auto-enabled when not a TTY)

# ---- Paths ---------------------------------------------------------------
FINFLOW_DATA_DIR=./data
FINFLOW_DUCKDB_PATH=./data/finflow.duckdb

# ---- Data sources --------------------------------------------------------
# Stooq needs no key.
FINFLOW_FRED_API_KEY=
FINFLOW_TWELVEDATA_API_KEY=
FINFLOW_ALPHAVANTAGE_API_KEY=

# ---- Alerts --------------------------------------------------------------
# Talk to @BotFather for the token, then message the bot once and read the chat
# id from https://api.telegram.org/bot<TOKEN>/getUpdates. Only this chat is
# obeyed: a bot token is discoverable, and /position GLD 0 from a stranger
# would corrupt the holdings the digest is computed from.
FINFLOW_TELEGRAM_BOT_TOKEN=
FINFLOW_TELEGRAM_CHAT_ID=

# Drift below this many percentage points is a hold, not an instruction. The
# guard on the >=95% no-action target — raise it if the digest gets chatty.
FINFLOW_REBALANCE_BAND_PP=5

# ---- Monitoring ----------------------------------------------------------
# The dead-man's switch. A monitor on the box cannot tell you the box is down,
# so this one deliberately runs elsewhere: https://healthchecks.io (free).
# Set the check to a 24h period with a 1h grace, so a missed run emails within
# the hour. Leave empty and the run says out loud that nothing is watching.
FINFLOW_HEALTHCHECKS_URL=

# ---- Backups -------------------------------------------------------------
# Must be a *different physical device* — an external disk or a NAS mount.
# A copy on the same disk is not a backup (PROJECT.md §11.3).
FINFLOW_BACKUP_DIR=
FINFLOW_BACKUP_KEEP_DAILY=30
FINFLOW_BACKUP_KEEP_MONTHLY=12
# An age public key. When set, backups are encrypted with the `age` binary
# before they leave the machine; without the binary the backup fails rather
# than quietly writing plaintext to removable media.
FINFLOW_AGE_RECIPIENT=

# ---- Ingestion tuning ----------------------------------------------------
FINFLOW_HTTP_TIMEOUT_SECONDS=30
FINFLOW_HTTP_MAX_RETRIES=5
