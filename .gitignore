# Secrets
.env
.env.local
*.pem
*.key

# Data — never committed
data/
*.duckdb
*.duckdb.wal
*.parquet

# ML artifacts. Anchored to the repository root: a bare `models/` also matches
# dbt/models/, which silently left the entire warehouse model layer untracked.
mlruns/
mlartifacts/
/models/

# dbt. Packages are installed from the committed package-lock.yml, so they are
# ignored the way node_modules is; the lockfile is what gets versioned.
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Dagster
.dagster/
dagster_home/
tmp*/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# dbt. Packages are installed from the committed package-lock.yml, so they are
# ignored the way node_modules is; the lockfile is what gets versioned.
dbt/target/
